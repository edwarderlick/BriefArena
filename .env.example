# BriefArena - Environment Variables Example
# Target Network: GenLayer Studio Next
# Chain ID: 61997
# RPC URL: https://studio-next.genlayer.com/api
# Explorer: https://explorer-studio-dev.genlayer.com/

# Deployed BriefArena contract address on Studio Next (Chain 61997)
# Canonical live deployment: 0x5614108eDBdAb6c0b6313725EDe8f1029F74F4F9
# Note: Old contract 0x4072... failed; do NOT use it.
VITE_BRIEF_ARENA_CONTRACT_ADDRESS=0x5614108eDBdAb6c0b6313725EDe8f1029F74F4F9

# Build-time Write Gate
# Set to 'true' to enable wallet connection & on-chain transactions using test GEN
# Set to 'false' (default) to keep the app in strictly read-only mode
VITE_WRITES_ENABLED=false
